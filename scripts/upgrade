#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression --message="Stopping Elastos Runtime..." --weight=2
ynh_systemd_action --service_name="$app" --action="stop"

ynh_script_progression --message="Updating source..." --weight=3
# Wipe install_dir before extract. Without --full_replace an upgrade mixes
# leftover files from the previous package (old patches, old pack overlay)
# into the new tree and ynh_setup_source can refuse to overwrite. Rust lives
# in /opt/$app/rust and runtime state lives in $data_dir, neither is here.
ynh_setup_source --dest_dir="$install_dir" --full_replace=1
mkdir -p "$install_dir/bin"
chown -R "$app:$app" "$install_dir"

#=================================================
# FETCH UPSTREAM RUNTIME
#=================================================
# Same pattern as install — pull upstream Elacity tarball pinned by
# UPSTREAM_VERSION. If the file's contents changed since the last
# install (sync-upstream.sh was used), this re-fetches the new version.
fetch_upstream_source "$install_dir"

#=================================================
# FETCH HEY CAPSULE PACK
#=================================================
fetch_hey_capsules "$install_dir"

#=================================================
# BUILD HEY APP CAPSULES (React → static bundle)
#=================================================
build_hey_app_capsules "$install_dir"

if [ ! -x "$(rustup_root)/cargo/bin/cargo" ]; then
    ynh_script_progression --message="Reinstalling Rust toolchain..." --weight=20
    install_rust_toolchain
fi

# Prefer prebuilt binaries (zero compile); fall back to a source rebuild
# and refresh the on-box cache so the next upgrade is a download, not cargo.
if ! maybe_download_prebuilt "$install_dir"; then
    ynh_script_progression --message="No prebuilt — rebuilding elastos + capsules from source..." --weight=300
    build_runtime_and_capsules
    cache_prebuilt "$install_dir"
fi

# Replace the binary in the client home with the freshly-built one. State
# in xdg-data (sources.json, components.json, capsules/) is preserved.
install -D -m 0755 -o "$app" -g "$app" \
    "$install_dir/elastos/target/debug/elastos" \
    "$(elastos_home)/.local/bin/elastos"

install_wrapper
install_cli_wrapper
ynh_add_systemd_config
ynh_add_nginx_config

# Make sure the at-rest encryption key for localhost-provider exists
# before the service starts. Idempotent — already-generated keys are
# left alone. Older installs predating this commit get one minted
# here; their existing plaintext files keep working via the
# legacy-data tolerance path in the provider's read code.
ynh_script_progression --message="Ensuring localhost-provider encryption key is present..." --weight=1
ensure_localhost_encryption_key

# Do not run `elastos setup --with` here. The install-time publisher is
# gone, so any component the previous install did not already have hangs
# on "Trusted source Carrier fetch failed". Native bins are copied below;
# every Home web capsule is copied by refresh_data_dir_capsules.

# Install native provider binaries DIRECTLY into the client bin/.
# `setup --with` fetches NEW components over Carrier from the install's temp
# publisher — which is torn down after install, so a brand-new provider times
# out on upgrade ("Trusted source Carrier fetch failed"). Copy the built
# binaries straight into bin/. Gossip is ElastOS Carrier, not peer-provider.
ynh_script_progression --message="Installing native provider binaries into client bin/..." --weight=2
CLIENT_BIN="$(elastos_home)/xdg-data/elastos/bin"
mkdir -p "$CLIENT_BIN"
for b in shell localhost-provider did-provider webspace-provider ipfs-provider; do
    src="$install_dir/elastos/target/release/$b"
    if [ -x "$src" ]; then
        install -m 0755 -o "$app" -g "$app" "$src" "$CLIENT_BIN/$b"
        echo "  installed bin/$b"
    fi
done

# Refresh every static-asset capsule's data_dir copy from the freshly
# unpacked install_dir/capsules/ tree. The runtime serves capsules
# from $data_dir, so a `yunohost app upgrade` that only updates
# install_dir has no effect on what users see. This is also how new
# Home apps (wallet, browser, people, ...) appear on an existing box:
# setup --with cannot fetch them without the install publisher.
ynh_script_progression --message="Refreshing data_dir capsule files from install_dir..." --weight=2
refresh_data_dir_capsules

# Reapply the Hey theme overlay after the capsule refresh — the
# previous overlay markers in style.css get stripped + re-appended,
# so this is safe to re-run on every upgrade.
ynh_script_progression --message="Reapplying Hey theme overlay..." --weight=1
apply_hey_theme_overlay "$(elastos_home)/xdg-data/elastos"

# Existing installs predating the P2P port fix get it opened here too.
open_peer_firewall_port

# ElastOS Carrier owns relays. Tear down leftover Hey iroh-relay sidecar
# from older packages and clear .relay-url.
retire_hey_relay_sidecar

ynh_script_progression --message="Starting Elastos Runtime..." --weight=3
ynh_systemd_action --service_name="$app" --action="start" \
    --log_path="/var/log/$app/$app.log" \
    --line_match="room gateway listening"

# Re-apply IPFS content peering (federation list may have changed; non-fatal).
ynh_script_progression --message="Configuring IPFS content peering..." --weight=1
configure_ipfs_peering || true

ynh_script_progression --message="Elastos Runtime upgraded." --last
