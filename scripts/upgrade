#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression --message="Stopping Elastos Runtime..." --weight=2
ynh_systemd_action --service_name="$app" --action="stop"

ynh_script_progression --message="Updating source..." --weight=3
ynh_setup_source --dest_dir="$install_dir"
mkdir -p "$install_dir/bin"
chown -R "$app:$app" "$install_dir"

#=================================================
# FETCH UPSTREAM RUNTIME
#=================================================
# Same pattern as install — pull upstream Elacity tarball pinned by
# UPSTREAM_VERSION. If the file's contents changed since the last
# install (sync-upstream.sh was used), this re-fetches the new version.
fetch_upstream_source "$install_dir"

if [ ! -x "$(rustup_root)/cargo/bin/cargo" ]; then
    ynh_script_progression --message="Reinstalling Rust toolchain..." --weight=20
    install_rust_toolchain
fi

ynh_script_progression --message="Rebuilding elastos + capsules..." --weight=300
build_runtime_and_capsules

# Replace the binary in the client home with the freshly-built one. State
# in xdg-data (sources.json, components.json, capsules/) is preserved.
install -D -m 0755 -o "$app" -g "$app" \
    "$install_dir/elastos/target/debug/elastos" \
    "$(elastos_home)/.local/bin/elastos"

install_wrapper
install_cli_wrapper
ynh_add_systemd_config
ynh_add_nginx_config

# Make sure the at-rest encryption key for localhost-provider exists
# before the service starts. Idempotent — already-generated keys are
# left alone. Older installs predating this commit get one minted
# here; their existing plaintext files keep working via the
# legacy-data tolerance path in the provider's read code.
ynh_script_progression --message="Ensuring localhost-provider encryption key is present..." --weight=1
ensure_localhost_encryption_key

# Make sure capsules added to the install flow since the previous
# upgrade get pulled in for existing installs too. `setup --with`
# is idempotent — already-installed components are a no-op.
#
# inbox / library / documents are the GUI-launchable data capsules
# that should appear in the dock's launcher. Notepad is intentionally
# absent: its capsule.json declares microvm + rootfs.ext4, which the
# install pipeline doesn't build yet.
ynh_script_progression --message="Ensuring GUI capsules (inbox/library/documents/hey-social/hey-messenger) are installed..." --weight=2
sudo -u "$app" \
    HOME="$(elastos_home)" \
    XDG_DATA_HOME="$(elastos_home)/xdg-data" \
    XDG_CONFIG_HOME="$(elastos_home)/.config" \
    "$install_dir/elastos/target/debug/elastos" setup --with inbox,library,documents,hey-social,hey-messenger \
    || ynh_print_warn --message="elastos setup --with inbox,library,documents,hey-social,hey-messenger failed (continuing — they may already be present)."

# Refresh every static-asset capsule's data_dir copy from the freshly
# unpacked install_dir/capsules/ tree. The runtime serves capsules
# from $data_dir (xdg-data/elastos/capsules/...), so a `yunohost app
# upgrade` that updates install_dir/ alone has no effect on what users
# actually see — every release would need a manual `cp -rf ... + chown
# + systemctl restart` dance to land bundle changes. This loop kills
# that dance.
#
# Why we touch every capsule, not just hey-social: each capsule's
# capsule.json + JS/CSS/HTML may have evolved since the last install.
# Refreshing static files is always safe; user-generated state under
# `xdg-data/elastos/capsules/<name>/state/` (or wherever a capsule
# writes runtime data) lives in the user namespace via the
# localhost-provider's per-user directory tree, not inside the
# capsule's own directory.
ynh_script_progression --message="Refreshing data_dir capsule files from install_dir..." --weight=2
CAPSULES_DATA_DIR="$(elastos_home)/xdg-data/elastos/capsules"
if [ -d "$install_dir/capsules" ] && [ -d "$CAPSULES_DATA_DIR" ]; then
    for capsule_src in "$install_dir/capsules"/*/; do
        [ -d "$capsule_src" ] || continue
        capsule_name="$(basename "$capsule_src")"
        capsule_dst="$CAPSULES_DATA_DIR/$capsule_name"
        if [ -d "$capsule_dst" ]; then
            cp -rf "$capsule_src". "$capsule_dst/"
        fi
    done
    chown -R "$app:$app" "$CAPSULES_DATA_DIR"
fi

# Reapply the Hey theme overlay after the capsule refresh — the
# previous overlay markers in style.css get stripped + re-appended,
# so this is safe to re-run on every upgrade.
ynh_script_progression --message="Reapplying Hey theme overlay..." --weight=1
apply_hey_theme_overlay "$(elastos_home)/xdg-data/elastos"

ynh_script_progression --message="Starting Elastos Runtime..." --weight=3
ynh_systemd_action --service_name="$app" --action="start" \
    --log_path="/var/log/$app/$app.log" \
    --line_match="room gateway listening"

ynh_script_progression --message="Elastos Runtime upgraded." --last
