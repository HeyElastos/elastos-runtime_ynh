# 0023-carrier-nat-seed-bootstrap.patch
# Fix: a NAT'd (relay-KEPT) node never forms peers — it gets 0 bootstrap peers and
# the global-mesh join (0016) falls into the DHT auto-discovery branch, which the
# code's own comment says cannot bootstrap behind NAT → 'Connecting…' forever.
#  (1) The seed block (0017: ELASTOS_MESH_SEED / cached-peer dial) was gated behind
#      'if relay_independent' — so a NAT'd host never seeded. Ungate it: seed for
#      relay-KEPT hosts too (they NEED a seed since DHT can't bootstrap behind NAT).
#  (2) join_gossip_topic now force-directs when bootstrap_peers is non-empty, so a
#      seeded NAT'd node joins VIA the seeds instead of the dead DHT branch.
# Requires a seed: set ELASTOS_MESH_SEED to a reachable (public VPS) node ticket, or
# rely on the persisted peer cache from a prior connection.
# Kill condition: drop if upstream makes DHT discovery work behind NAT.
--- a/elastos/crates/elastos-server/src/carrier.rs
+++ b/elastos/crates/elastos-server/src/carrier.rs
@@ -425,6 +425,11 @@
     // 0015 boot-rejoin / 0016 global-mesh joins stop falling into the dead DHT branch.
     let force_direct = force_direct
         || state.relay_independent
+        // HEY PATCH 0023: a relay-KEPT (NAT'd) host that has seeded bootstrap peers must
+        // join VIA them, not the DHT auto-discovery branch (which cannot bootstrap behind
+        // NAT). Without this the 0016 global-mesh join falls into the dead DHT branch and
+        // forms 0 peers forever.
+        || !state.bootstrap_peers.is_empty()
         || std::env::var("ELASTOS_RELAY_INDEPENDENT").ok().as_deref() == Some("1");
     let bootstrap_peers = state.bootstrap_peers.clone();
     if force_direct {
@@ -1047,11 +1052,13 @@
         }
     }
 
-    // HEY PATCH 0017: relay-independent seeding — dial the peers we already know
-    // (ELASTOS_MESH_SEED connect tickets, or the persisted peer cache) DIRECTLY and
-    // make them the gossip bootstrap, so the mesh forms with ZERO relay. Runs before
-    // any topic join so bootstrap_peers is populated for the force-direct joins.
-    if relay_independent {
+    // HEY PATCH 0017 + 0023: seed the gossip bootstrap from the peers we already know
+    // (ELASTOS_MESH_SEED connect tickets, or the persisted peer cache) and dial them.
+    // Runs for BOTH relay-independent hosts (mesh with zero relay) AND relay-KEPT hosts
+    // behind NAT — the global-mesh join's DHT auto-discovery branch CANNOT bootstrap
+    // behind NAT (see join_gossip_topic), so a NAT'd node MUST seed to enter the mesh.
+    // Runs before any topic join so bootstrap_peers is populated for the force-direct joins.
+    {
         // Seed from the persisted cache (peers found during the earlier relay phase)
         // plus any ELASTOS_MESH_SEED override tickets, then connect DIRECTLY. These
         // become the gossip bootstrap so the mesh forms with ZERO relay.
@@ -1079,8 +1086,9 @@
             add_ticket_endpoints(&ml, &mut state.bootstrap_peers, &deduped, true);
             connect_ticket_endpoints(&ep, &gs, peers, &deduped).await;
             info!(
-                "carrier: relay-independent — seeded + connected {} direct peer(s) (cache+env)",
-                deduped.len()
+                "carrier: seeded + connected {} bootstrap peer(s) (cache+env, relay_independent={})",
+                deduped.len(),
+                relay_independent
             );
         }
     }
