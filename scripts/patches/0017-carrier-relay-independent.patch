+async fn direct_addr_announce_loop(
+    endpoint: Endpoint,
+    gossip: Gossip,
+    memory_lookup: MemoryLookup,
+    peers: Arc<Mutex<Vec<String>>>,
+    signing_key_bytes: [u8; 32],
+    data_dir: PathBuf,
+) {
+    const ANNOUNCE_TOPIC: &str = "hey/v0/addr-announce/1";
+
+    // Join the announce topic via the SAME DHT/relay auto-discovery path the global
+    // mesh uses, so it meshes cross-host with no bootstrap peers required.
+    let dtt_sk = ed25519_dalek3::SigningKey::from_bytes(&signing_key_bytes);
+    let record_publisher = RecordPublisher::new(
+        TopicId::new(ANNOUNCE_TOPIC.to_string()),
+        dtt_sk,
+        None,
+        TOPIC_DISCOVERY_SECRET.to_vec(),
+        distributed_topic_tracker::Config::default(),
+    );
+    let topic = match gossip
+        .subscribe_and_join_with_auto_discovery_no_wait(record_publisher)
+        .await
+    {
+        Ok(t) => t,
+        Err(e) => {
+            tracing::warn!("carrier: addr-announce join failed: {}", e);
+            return;
+        }
+    };
+    let (sender, mut receiver) = match topic.split().await {
+        Ok(parts) => parts,
+        Err(e) => {
+            tracing::warn!("carrier: addr-announce split failed: {}", e);
+            return;
+        }
+    };
+    info!("carrier: direct-address announce active on '{}'", ANNOUNCE_TOPIC);
+
+    let self_id = endpoint.id();
+
+    // Receiver: inject every peer's advertised direct address into the address
+    // book, and dial it once (iroh maintains + hole-punches the path afterward).
+    {
+        let endpoint = endpoint.clone();
+        let gossip = gossip.clone();
+        let memory_lookup = memory_lookup.clone();
+        let peers = peers.clone();
+        let data_dir = data_dir.clone();
+        tokio::spawn(async move {
+            let mut dialed: Vec<iroh::EndpointId> = Vec::new();
+            loop {
+                match receiver.next().await {
+                    Ok(iroh_gossip::api::Event::Received(msg)) => {
+                        let ticket = match std::str::from_utf8(&msg.content) {
+                            Ok(s) => s,
+                            Err(_) => continue,
+                        };
+                        for addr in decode_ticket_endpoints(ticket) {
+                            if addr.id == self_id {
+                                continue;
+                            }
+                            // Quiet address-book refresh on every (re)announce: give
+                            // iroh BOTH addrs (relay for fallback + direct).
+                            memory_lookup.add_endpoint_info(addr.clone());
+                            // Dial once per peer; re-announces only refresh the book.
+                            if !dialed.contains(&addr.id) {
+                                dialed.push(addr.id);
+                                // Persist for relay-independent graduation on next boot.
+                                cache_peer(&data_dir, &addr);
+                                // Dial DIRECT-ONLY (strip the relay addr). iroh 0.97's
+                                // multipath relay->direct UPGRADE is flaky here (paths get
+                                // Abandoned ValidationFailed even though raw UDP :4433 works),
+                                // so instead we open a connection whose PRIMARY path is the
+                                // direct :4433 path — validated by the initial QUIC handshake,
+                                // not the multipath PATH_CHALLENGE. gossip multiplexes its
+                                // topics over this direct connection. The relay is still in the
+                                // address book (above) as fallback if the direct dial fails.
+                                let direct_addrs: Vec<iroh::TransportAddr> = addr
+                                    .addrs
+                                    .iter()
+                                    .filter(|a| matches!(a, iroh::TransportAddr::Ip(_)))
+                                    .cloned()
+                                    .collect();
+                                info!(
+                                    "carrier: addr-announce RECV from {} ({} direct addr) — direct-dialing",
+                                    &addr.id.to_string()[..12],
+                                    direct_addrs.len()
+                                );
+                                if !direct_addrs.is_empty() {
+                                    let direct_only =
+                                        iroh::EndpointAddr::from(addr.id).with_addrs(direct_addrs);
+                                    let c = connect_ticket_endpoints(
+                                        &endpoint,
+                                        &gossip,
+                                        peers.clone(),
+                                        std::slice::from_ref(&direct_only),
+                                    )
+                                    .await;
+                                    info!(
+                                        "carrier: addr-announce direct-dial result for {}: connected={:?}",
+                                        &addr.id.to_string()[..12],
+                                        c
+                                    );
+                                }
+                            }
+                        }
+                    }
+                    Ok(_) => {}
+                    Err(e) => {
+                        if e.to_string().contains("closed") {
+                            break;
+                        }
+                    }
+                }
+            }
+        });
+    }
+
+    // Sender: re-broadcast our full EndpointAddr (loopback stripped) every 30s. The
+    // first interval tick fires immediately, so a freshly-joined peer goes direct
+    // within one interval.
+    let mut ticker = tokio::time::interval(Duration::from_secs(30));
+    loop {
+        ticker.tick().await;
+        let mut watcher = endpoint.watch_addr();
+        let addr = watcher.get();
+        let public_addrs: Vec<iroh::TransportAddr> = addr
+            .addrs
+            .iter()
+            .filter(|t| match t {
+                iroh::TransportAddr::Ip(sa) => !sa.ip().is_loopback(),
+                _ => true,
+            })
+            .cloned()
+            .collect();
+        if public_addrs.is_empty() {
+            continue;
+        }
+        let ndirect = public_addrs
+            .iter()
+            .filter(|a| matches!(a, iroh::TransportAddr::Ip(_)))
+            .count();
+        let announce = iroh::EndpointAddr::from(addr.id).with_addrs(public_addrs);
+        let ticket_json = serde_json::json!({ "topic": null, "endpoints": [announce] });
+        let ticket_bytes = serde_json::to_vec(&ticket_json).unwrap_or_default();
+        let mut ticket_str = data_encoding::BASE32_NOPAD.encode(&ticket_bytes);
+        ticket_str.make_ascii_lowercase();
+        match sender.broadcast(ticket_str.into_bytes()).await {
+            Ok(_) => info!(
+                "carrier: addr-announce SENT ({} direct addr) on '{}'",
+                ndirect, ANNOUNCE_TOPIC
+            ),
+            Err(e) => tracing::debug!("carrier: addr-announce broadcast failed: {}", e),
+        }
+    }
+}
