+/// HEY PATCH 0017 (REMOVABLE): direct-address self-announce so peer DATA flows
+/// direct P2P and the relay is used ONLY to connect/discover (never to carry data).
+///
+/// iroh's pkarr publisher advertises a node's RELAY URL *only* (never its direct
+/// addresses) whenever a relay is configured, and the mainline DHT that would
+/// otherwise carry direct addresses cannot bootstrap on these hosts. Net effect:
+/// peers learn each other ONLY by relay, iroh's hole-puncher has no direct
+/// candidate to punch to, and all gossip DATA rides the relay even though direct
+/// UDP on :4433 works (verified end-to-end: a 100-msg burst went 241KB via relay,
+/// ~0 direct — and flipped to 247KB direct once peers were handed each other's
+/// direct addr).
+///
+/// This closes the gap WITHOUT patching iroh: every node periodically broadcasts
+/// its OWN full EndpointAddr (relay + public direct, from endpoint.watch_addr())
+/// on a fixed gossip topic. On receipt each peer injects the sender's direct
+/// address into the endpoint address book and dials it once — exactly what the
+/// manual `connect` op does. iroh then hole-punches the direct path and the relay
+/// drops to connect/discovery-only on its own.
+///
+/// KILL CONDITION: drop when iroh/pkarr publishes direct addresses alongside the
+/// relay URL (or the mainline DHT bootstraps reliably here), so peers learn direct
+/// addresses through normal discovery.
+/// HEY PATCH 0017: is this host PUBLICLY REACHABLE (a server with a public IP on its
+/// outbound interface) rather than behind NAT (a phone/laptop)? Only publicly-reachable
+/// hosts auto-graduate to relay-independent — a NAT'd client KEEPS the relay, because it
+/// needs it for discovery, hole-punch coordination, and as a data fallback when a direct
+/// path is impossible (symmetric/CGNAT). Determined from the source IP the OS picks for
+/// outbound routing: no packet is sent, it is a pure local routing-table lookup.
+fn host_is_publicly_reachable() -> bool {
+    fn probe(dst: &str) -> Option<std::net::IpAddr> {
+        let dst: std::net::SocketAddr = dst.parse().ok()?;
+        let bind = if dst.is_ipv6() { "[::]:0" } else { "0.0.0.0:0" };
+        let s = std::net::UdpSocket::bind(bind).ok()?;
+        s.connect(dst).ok()?;
+        s.local_addr().ok().map(|a| a.ip())
+    }
+    // IPv4 verdict first (the reliable discriminator); fall back to IPv6 only on a
+    // v4-less host. A phone on v4-NAT returns a private v4 here → not public.
+    match probe("192.0.2.1:443").or_else(|| probe("[2001:db8::1]:443")) {
+        Some(ip) => ip_is_global(&ip),
+        None => false, // can't determine → safe default: assume NAT, keep the relay
+    }
+}
+fn ip_is_global(ip: &std::net::IpAddr) -> bool {
+    match ip {
+        std::net::IpAddr::V4(v4) => {
+            let o = v4.octets();
+            !(v4.is_private()
+                || v4.is_loopback()
+                || v4.is_link_local()
+                || v4.is_broadcast()
+                || v4.is_unspecified()
+                || o[0] == 0
+                || (o[0] == 100 && o[1] >= 64 && o[1] <= 127)) // 100.64/10 CGNAT
+        }
+        std::net::IpAddr::V6(v6) => {
+            let s = v6.segments();
+            !(v6.is_loopback()
+                || v6.is_unspecified()
+                || (s[0] & 0xffc0) == 0xfe80 // link-local fe80::/10
+                || (s[0] & 0xfe00) == 0xfc00) // unique-local fc00::/7
+        }
+    }
+}
+
+/// HEY PATCH 0017: persisted peer cache. The direct addresses we learn during the
+/// relay-assisted discovery phase are written here so the NEXT boot can come up
+/// relay-INDEPENDENT (relay disabled, data 100% direct) and reach its peers
+/// immediately — "use the relay to find each other once, then cut the cord."
+fn peer_cache_path(data_dir: &std::path::Path) -> std::path::PathBuf {
+    data_dir.join("carrier-peers.json")
+}
+fn load_cached_peers(data_dir: &std::path::Path) -> Vec<iroh::EndpointAddr> {
+    std::fs::read(peer_cache_path(data_dir))
+        .ok()
+        .and_then(|b| serde_json::from_slice::<Vec<iroh::EndpointAddr>>(&b).ok())
+        .unwrap_or_default()
+}
+fn cache_peer(data_dir: &std::path::Path, addr: &iroh::EndpointAddr) {
+    // Persist DIRECT addresses only (the relay addr is useless once independent).
+    let direct: Vec<iroh::TransportAddr> = addr
+        .addrs
+        .iter()
+        .filter(|t| match t {
+            iroh::TransportAddr::Ip(sa) => !sa.ip().is_loopback(),
+            _ => false,
+        })
+        .cloned()
+        .collect();
+    if direct.is_empty() {
+        return;
+    }
+    let entry = iroh::EndpointAddr::from(addr.id).with_addrs(direct);
+    let mut peers = load_cached_peers(data_dir);
+    peers.retain(|p| p.id != addr.id);
+    peers.push(entry);
+    if let Ok(bytes) = serde_json::to_vec(&peers) {
+        let _ = std::fs::write(peer_cache_path(data_dir), bytes);
+    }
+}
