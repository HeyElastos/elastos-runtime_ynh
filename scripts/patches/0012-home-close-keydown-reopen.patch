@@ -539,6 +542,15 @@
     if (shouldIgnoreWindowControl(node, "close", event)) {
       return;
     }
+    // Defensive: keep this close click from reaching any document-level click
+    // handler. NOTE this does NOT neutralise the keyboard (Enter/Space) close
+    // path — the browser dispatches `keydown` BEFORE the synthesized click, and
+    // that keydown is already handled (harmlessly ignored, because the close
+    // button is still inside `.window` when shouldIgnoreDesktopKeydown runs)
+    // before we get here. The real guard against the close→reopen loop is
