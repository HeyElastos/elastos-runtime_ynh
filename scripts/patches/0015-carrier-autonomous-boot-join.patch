+fn carrier_topics_path(data_dir: &std::path::Path) -> std::path::PathBuf {
+    data_dir.join("carrier-topics.json")
+}
+fn persist_joined_topics(data_dir: &std::path::Path, topics: &std::collections::HashSet<String>) {
+    let list: Vec<&String> = topics.iter().collect();
+    if let Ok(json) = serde_json::to_string(&list) {
+        let _ = std::fs::write(carrier_topics_path(data_dir), json);
+    }
+}
+fn load_persisted_topics(data_dir: &std::path::Path) -> Vec<String> {
+    std::fs::read_to_string(carrier_topics_path(data_dir))
+        .ok()
+        .and_then(|s| serde_json::from_str::<Vec<String>>(&s).ok())
+        .unwrap_or_default()
+}
