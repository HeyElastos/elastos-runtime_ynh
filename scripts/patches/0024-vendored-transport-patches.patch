# HEY-CAPSULE-PACK PATCH 0024 (REMOVABLE): build the runtime Carrier against the
# SAME vendored/patched iroh stack every other Hyper product runs.
#
# Cargo does not inherit [patch.crates-io] across workspaces, so the vendored
# transport fixes that Hyper-Desktop, Hyper-Skia and hey-mobile-runtime all carry
# have to be repeated at the elastos workspace root, or this runtime's Carrier is
# the one process in the fleet running unpatched crates.io.
#
# The gap matters most here: this is the always-on VPS process. The iroh fix is a
# RemoteMap leak (is_idle counted a connection the app had already dropped as
# live, so the per-remote actor never hit its 60s idle timeout — sustained CPU and
# RSS climb, measured ~36% avg CPU / 442 MB over 8h). A phone gets restarted; a
# home server is expected to stay up for months.
#
# Paths point into the Hey capsule pack: fetch_hey_capsules() unpacks it to
# $install_dir/capsules/ BEFORE build_runtime_and_capsules() runs, so
# capsules/vendor/ is on disk at build time. The pack vendors these crates itself
# (it ships as a standalone tarball; hey-engine does not exist on the box) and
# Hey-capsules/scripts/sync-vendor.sh keeps them byte-identical to
# hey-engine/vendor/.
#
# Also pins noq-udp: the vendored iroh calls noq_udp::hyper_rearm_dead_families,
# which exists ONLY in the vendored noq-udp 1.0.1, so the two are a matched pair.
# Without the pin a from-scratch resolve pulls iroh-relay 1.0.3 -> noq 1.1 ->
# noq-udp 1.1.1, [patch.crates-io] silently stops applying, and the build fails on
# the missing function.
#
# KILL CONDITION: drop when these fixes are released upstream in iroh /
# iroh-gossip / noq-udp / netdev and the pack stops vendoring them.
--- a/elastos/Cargo.toml
+++ b/elastos/Cargo.toml
@@ -41,3 +41,35 @@ opt-level = 1                 # Optimize deps (compiled once, run many times)
 [profile.test]
 opt-level = 0
 debug = "line-tables-only"
+
+# ── HEY-CAPSULE-PACK PATCH 0024 (REMOVABLE) ──────────────────────────────────
+# SAME PATCHES AS EVERY OTHER PRODUCT. Cargo does not inherit [patch.crates-io]
+# across workspaces, so the vendored transport fixes the Hyper desktop/Skia apps
+# and hey-mobile-runtime all carry must be repeated at THIS workspace root, or
+# the runtime's built-in Carrier silently builds unpatched crates.io while every
+# other Hyper product runs patched.
+#
+# That gap matters most HERE: this is the always-on VPS process. The iroh fix is
+# a RemoteMap leak (is_idle counted a connection the app had already dropped as
+# live, so the per-remote actor never hit its 60s idle timeout — a sustained CPU
+# and RSS climb measured at ~36% avg CPU / 442 MB over 8h). A phone can be
+# restarted; a relay/home server is expected to sit up for months.
+#
+# Paths point into the Hey capsule pack, which scripts/_common.sh
+# fetch_hey_capsules() unpacks to $install_dir/capsules/ BEFORE
+# build_runtime_and_capsules() runs — so capsules/vendor/ is on disk by build
+# time. The pack vendors these itself (it is fetched as a standalone tarball and
+# hey-engine does not exist on the box); Hey-capsules/scripts/sync-vendor.sh
+# keeps those copies byte-identical to hey-engine/vendor/.
+#
+# The vendored versions MUST equal what the graph resolves — iroh =1.0.2 and
+# iroh-gossip 0.101 in crates/elastos-server/Cargo.toml (patch 0018) — or Cargo
+# ignores the patch silently and this whole block becomes a no-op.
+#
+# KILL CONDITION: drop when these fixes land upstream in iroh/iroh-gossip/
+# noq-udp/netdev releases and the pack stops vendoring them.
+[patch.crates-io]
+iroh = { path = "../capsules/vendor/iroh" }
+iroh-gossip = { path = "../capsules/vendor/iroh-gossip" }
+netdev = { path = "../capsules/vendor/netdev" }
+noq-udp = { path = "../capsules/vendor/noq-udp" }
--- a/elastos/crates/elastos-server/Cargo.toml
+++ b/elastos/crates/elastos-server/Cargo.toml
@@ -109,6 +109,14 @@ libc = "0.2"
 # These versions form one coordinated generation and must move together.
 iroh = "=1.0.2"
 iroh-gossip = "=0.101.0"
+# RESOLVER PIN, not a code dependency (patch 0024). The vendored iroh calls
+# noq_udp::hyper_rearm_dead_families, which exists ONLY in the vendored noq-udp
+# 1.0.1 — the two are a matched pair. Nothing else expresses that, and a
+# from-scratch resolve pulls iroh-relay 1.0.3 -> noq 1.1 -> noq-udp 1.1.1, at
+# which point [patch.crates-io] silently stops applying and the build fails on
+# the missing function. This forces the resolver back onto the 1.0.x line —
+# the exact graph Hyper-Desktop locks. Drop with patch 0024.
+noq-udp = "=1.0.1"
 iroh-mdns-address-lookup = "=0.4.0"
 distributed-topic-tracker = "=0.3.5"
 futures-lite = "2.6"
