--- a/elastos/crates/elastos-server/Cargo.toml
+++ b/elastos/crates/elastos-server/Cargo.toml
@@ -83,7 +83,8 @@ base64 = "0.22"
 ed25519-dalek = { version = "2.1", features = ["rand_core"] }
 # ed25519-dalek 3.x needed by distributed-topic-tracker for DHT record signing.
 # Cargo resolves both versions; we convert between them via raw key bytes.
-ed25519-dalek3 = { package = "ed25519-dalek", version = "=3.0.0-pre.1" }
+# Pinned to what iroh 1.0.2 resolves — see the iroh note below before changing.
+ed25519-dalek3 = { package = "ed25519-dalek", version = "=3.0.0-rc.0" }
 
 # Directory helpers
 dirs = "5.0"
@@ -101,9 +102,16 @@ zip = { version = "2.4.2", default-features = false, features = ["deflate-flate2
 libc = "0.2"
 
 # Built-in Carrier transport (P2P for updates, gossip messaging, DHT discovery)
-iroh = { version = "0.97", features = ["address-lookup-mdns"] }
-iroh-gossip = "0.97"
-distributed-topic-tracker = "0.3.0"
+# EXACT pin, not "1": a caret req floats to whatever 1.x is newest on the day an
+# operator installs, so two installs a week apart would run different carriers.
+# 1.0.2 is also the version the Hey engine (hey-engine/vendor/iroh) vendors, so
+# the runtime carrier and the Hey capsules stay on one iroh generation.
+# Bumping this requires bumping ed25519-dalek3 in lockstep — iroh 1.0.2 resolves
+# ed25519-dalek =3.0.0-rc.0 while 1.0.3 wants 3.0.0, and mixing them fails to
+# resolve at all.
+iroh = { version = "=1.0.2", features = ["unstable-net-report"] }
+iroh-gossip = "0.101"
+distributed-topic-tracker = "0.3.5"
 futures-lite = "2.6"
 getrandom = "0.2"
 tokio-util = "0.7"  # CancellationToken for dtt 0.3 GossipReceiver
