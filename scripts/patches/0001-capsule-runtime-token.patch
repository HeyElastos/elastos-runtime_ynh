+// HEY-CAPSULE-PACK PATCH — capsule_runtime_token endpoint
+// ---------------------------------------------------------------------------
+
+#[derive(serde::Serialize)]
+struct HeyCapsuleRuntimeTokenResponse {
+    token: String,
+}
+
+// POST /api/apps/:capsule/runtime-token
+//
+// Validates the x-elastos-home-token header (launch envelope) against
+// the URL-named capsule, then mints a real session bearer via the
+// runtime's /api/auth/attach internal endpoint. Returns the bearer
+// in { token } so the calling capsule can use it as Authorization:
+// Bearer for /api/localhost/*, /api/capability/*, /api/provider/*,
+// etc. on the :3000 runtime listener.
+//
+// Same endpoint shape this fork's v0.2 build had — kept here as a
+// targeted patch on top of upstream v0.3 until upstream provides
+// an equivalent.
+async fn hey_capsule_runtime_token(
+    State(state): State<crate::api::gateway::GatewayState>,
+    Path(capsule): Path<String>,
+    headers: HeaderMap,
+) -> Result<Json<HeyCapsuleRuntimeTokenResponse>, (StatusCode, Json<serde_json::Value>)> {
+    // Home + system have their own dedicated auth paths upstream-side;
+    // refuse here so the two flows don't drift.
+    if capsule == HOME_CAPSULE_ID || capsule == SYSTEM_CAPSULE_ID {
+        return Err((
+            StatusCode::NOT_FOUND,
+            Json(serde_json::json!({
+                "error": "this endpoint is for third-party additive capsules only",
+            })),
+        ));
+    }
+
+    // Validate the launch envelope binds to the URL-named capsule.
+    let capsule_ref: &str = capsule.as_str();
+    if let Err(err) = require_home_launch_token_for_any(&state.data_dir, &headers, &[capsule_ref]) {
+        return Err((
+            StatusCode::FORBIDDEN,
+            Json(serde_json::json!({ "error": err.to_string() })),
+        ));
+    }
+
+    // Mint a session bearer via the runtime's attach endpoint.
+    let Some(coords) = gateway_home_runtime::load_live_runtime_coords(&state.data_dir).await else {
+        return Err((
+            StatusCode::SERVICE_UNAVAILABLE,
+            Json(serde_json::json!({ "error": "local runtime is not running" })),
+        ));
+    };
+    let client = match reqwest::Client::builder()
+        .timeout(std::time::Duration::from_secs(5))
+        .build()
+    {
+        Ok(c) => c,
+        Err(err) => {
+            return Err((
+                StatusCode::INTERNAL_SERVER_ERROR,
+                Json(serde_json::json!({ "error": format!("http client: {err}") })),
+            ));
+        }
+    };
+    let token = match gateway_home_runtime::gateway_attach_runtime_token(
+        &client,
+        &coords.api_url,
+        &coords.attach_secret,
+        "capsule",
+    )
+    .await
+    {
+        Ok(t) => t,
+        Err(err) => {
+            return Err((
+                StatusCode::INTERNAL_SERVER_ERROR,
+                Json(serde_json::json!({ "error": format!("attach: {err}") })),
+            ));
+        }
+    };
+    Ok(Json(HeyCapsuleRuntimeTokenResponse { token }))
+}
