+/// Capsule ids that DECLARE `elastos://<scheme>/*` in their own manifest.
+///
+/// The runtime already parses `permissions.messaging` into `CapsuleManifest`
+/// and then never consults it for provider access, so a third-party capsule
+/// whose manifest correctly asks for a scheme is still refused. This reads the
+/// field that is already there.
+///
+/// Only ACTIVE, INSTALLED capsules are considered — `list_active_capsule_manifests`
+/// cross-checks the on-disk manifest against components.json, so dropping a
+/// crafted capsule.json into the data dir grants nothing on its own.
+///
+/// This does not widen authority by itself: the caller still has to present a
+/// valid, signed, non-delegatable, unexpired home-launch token whose
+/// `executable_actor` is one of these ids, and the scheme's provider still has
+/// to be registered. It replaces WHO is on the list, not what a token means.
+fn capsules_declaring_scheme(data_dir: &std::path::Path, scheme: &str) -> Vec<String> {
+    crate::api::capsule_inventory::list_active_capsule_manifests(data_dir)
+        .into_iter()
+        .filter(|manifest| {
+            manifest
+                .permissions
+                .messaging
+                .iter()
+                .any(|grant| messaging_grant_covers_scheme(grant, scheme))
+        })
+        .map(|manifest| manifest.name)
+        .collect()
+}
+
+/// Does a `permissions.messaging` entry grant this provider scheme?
+///
+/// Entries are `elastos://<scheme>/...` — `elastos://peer/*` being the common
+/// shape. Compared scheme-level only: ops are not narrowed here. A bare
+/// `elastos://peer` counts. A wildcard scheme grants nothing, or one manifest
+/// line would claim every provider at once.
+fn messaging_grant_covers_scheme(grant: &str, scheme: &str) -> bool {
+    let Some(rest) = grant.strip_prefix("elastos://") else {
+        return false;
+    };
+    let granted = rest.split('/').next().unwrap_or("");
+    !granted.is_empty() && granted != "*" && granted == scheme
+}
